# URL base do portal (padrão: produção)
DETRAN_BASE_URL=https://leilao.detran.mg.gov.br

# Postgres local (docker compose up -d)
DATABASE_URL=postgresql://scraper:scraper@localhost:5435/detran_leiloes

# Schema analítico lido pela UI (default: mart_dbt)
MART_SCHEMA=mart_dbt

# Fotos da galeria (content-addressed). Default: data/imagens no repo.
# IMAGENS_DIR=E:/Github/scraping-detranmg/data/imagens

# Sessão logada (header Cookie do browser). Obrigatório para --lances.
# Não commitar. Expira; se aparecer HTML de login, copie de novo.
# DETRAN_COOKIE="PHPSESSID=...; ..."
